# Copy this file to .env and fill in real values.

# Firebase (client-side config - inlined into the app bundle by Expo, EXPO_PUBLIC_ prefix required)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend APIs
EXPO_PUBLIC_TTS_API_URL=
EXPO_PUBLIC_CONVERT_API_URL=

# OpenAI secret key - keep WITHOUT the EXPO_PUBLIC_ prefix so it is not
# bundled into the app. Route OpenAI calls through your backend instead.
OPEN_AI_API_KEY=
